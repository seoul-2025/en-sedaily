      DYNAMODB_TABLE_ARTICLES = "seodaily-eng-articles-dev"
    }
  }
}

# Lambda Function: Delete Article
resource "aws_lambda_function" "admin_delete" {
  function_name = "seodaily-eng-admin-delete-dev"
  handler       = "handlers.admin_handler.lambda_handler_delete"
  runtime       = "python3.11"
  role          = aws_iam_role.lambda_execution.arn
  timeout       = 30
  memory_size   = 512

  s3_bucket = "seodaily-eng-lambda-packages-dev"
  s3_key    = "lambda-admin.zip"

  environment {
