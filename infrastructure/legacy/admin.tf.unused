# Admin Lambda Functions for CMS

# Lambda Function: List Articles
resource "aws_lambda_function" "admin_list" {
  function_name = "seodaily-eng-admin-list-dev"
  handler       = "handlers.admin_handler.lambda_handler_list"
  runtime       = "python3.11"
  role          = aws_iam_role.lambda_execution.arn
  timeout       = 30
  memory_size   = 512

  s3_bucket = "seodaily-eng-lambda-packages-dev"
  s3_key    = "lambda-admin.zip"

  environment {
    variables = {
      DYNAMODB_TABLE_ARTICLES = "seodaily-eng-articles-dev"
    }
  }
}

# Lambda Function: Get Article
resource "aws_lambda_function" "admin_get" {
  function_name = "seodaily-eng-admin-get-dev"
  handler       = "handlers.admin_handler.lambda_handler_get"
  runtime       = "python3.11"
  role          = aws_iam_role.lambda_execution.arn
  timeout       = 30
  memory_size   = 512

  s3_bucket = "seodaily-eng-lambda-packages-dev"
  s3_key    = "lambda-admin.zip"

  environment {
    variables = {
      DYNAMODB_TABLE_ARTICLES = "seodaily-eng-articles-dev"
    }
  }
}

# Lambda Function: Update Article
resource "aws_lambda_function" "admin_update" {
  function_name = "seodaily-eng-admin-update-dev"
  handler       = "handlers.admin_handler.lambda_handler_update"
  runtime       = "python3.11"
  role          = aws_iam_role.lambda_execution.arn
  timeout       = 30
  memory_size   = 512

  s3_bucket = "seodaily-eng-lambda-packages-dev"
  s3_key    = "lambda-admin.zip"

  environment {
