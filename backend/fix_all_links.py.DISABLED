#!/usr/bin/env python3
"""
Fix all article links to use proper Seoul Economic URLs
For articles without provider_link_page, construct URL from news_id
"""
import boto3
import sys

def fix_all_links():
    dynamodb = boto3.resource('dynamodb', region_name='us-east-1')
    table = dynamodb.Table('seodaily-eng-articles-dev')
    
    print("Scanning all articles...")
    
    # Scan all items
    response = table.scan()
    items = response.get('Items', [])
    
    # Handle pagination
    while 'LastEvaluatedKey' in response:
        response = table.scan(ExclusiveStartKey=response['LastEvaluatedKey'])
        items.extend(response.get('Items', []))
    
    print(f"Found {len(items)} total articles\n")
    
    updated = 0
    already_good = 0
    
    for item in items:
        news_id = item.get('news_id')
        current_link = item.get('original_link', '')
        
        # Check if link is already in short format (like 2H1KOKI6IM)
        if current_link and 'sedaily.com/NewsView/' in current_link:
            link_part = current_link.split('/NewsView/')[-1]
            # If it's already a short code (not a news_id format)
            if not link_part.startswith('02100311.'):
                already_good += 1
                print(f"✓ {news_id[:20]}... already has short link: {link_part}")
                continue
        
        # Construct proper URL from news_id
        new_link = f"https://www.sedaily.com/NewsView/{news_id}"
        
        try:
            table.update_item(
                Key={'news_id': news_id},
                UpdateExpression='SET original_link = :link',
                ExpressionAttributeValues={':link': new_link}
            )
            updated += 1
            title = item.get('title_en', item.get('title_ko', 'Unknown'))[:50]
            print(f"✓ Updated {news_id}: {title}...")
        except Exception as e:
            print(f"✗ Failed to update {news_id}: {e}")
    
    print(f"\n{'='*60}")
    print(f"Summary:")
    print(f"  Total articles: {len(items)}")
    print(f"  Already good: {already_good}")
    print(f"  Updated: {updated}")
    print(f"  All links now use: https://www.sedaily.com/NewsView/[news_id]")
    print(f"{'='*60}")

if __name__ == "__main__":
    fix_all_links()
