# BigKinds API Configuration
BIGKINDS_API_KEY=your-bigkinds-api-key-here
BIGKINDS_API_URL=https://tools.kinds.or.kr

# AWS Configuration
AWS_REGION=us-east-1

# Redis Cache Configuration
REDIS_HOST=your-redis-host.cache.amazonaws.com
REDIS_PORT=6379
CACHE_TTL=604800

# DynamoDB Configuration
DYNAMODB_TABLE=seodaily-eng-metadata-dev

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
