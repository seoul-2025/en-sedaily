# BigKinds API Configuration
BIGKINDS_API_KEY=your_bigkinds_api_key_here
BIGKINDS_API_URL=https://tools.kinds.or.kr

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL_ID=claude-opus-4-5-20251101

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# DynamoDB Configuration
DYNAMODB_TABLE_ARTICLES=seodaily-eng-articles-dev
DYNAMODB_TABLE_METADATA=seodaily-eng-metadata-dev

# Redis Cache Configuration (Optional)
REDIS_HOST=your_redis_host_here
REDIS_PORT=6379
CACHE_TTL=604800

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
